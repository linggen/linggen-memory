{
  "name": "@linggen/linggen",
  "version": "0.1.4",
  "description": "OpenClaw plugin for Linggen — automatic memory recall, always-on core identity, project-scoped writes, and the local ling-mem + engine MCP servers.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://linggen.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linggen/linggen-memory.git",
    "directory": "plugins/openclaw"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "linggen",
    "memory",
    "ling-mem",
    "cross-host"
  ],
  "openclaw": {
    "extensions": [
      "./src/index.mjs"
    ],
    "runtimeExtensions": [
      "./src/index.mjs"
    ],
    "compat": {
      "pluginApi": ">=2026.5.6",
      "minGatewayVersion": "2026.5.6"
    },
    "build": {
      "openclawVersion": "2026.5.6",
      "pluginSdkVersion": "2026.5.6"
    }
  },
  "files": [
    "src/",
    "skills/",
    "commands/",
    "scripts/",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "sync": "bash scripts/sync-from-plugin.sh",
    "build": "for f in src/*.mjs; do node --check \"$f\" || exit 1; done",
    "test": "node --test test/*.test.mjs",
    "typecheck": "for f in src/*.mjs; do node --check \"$f\" || exit 1; done"
  }
}
